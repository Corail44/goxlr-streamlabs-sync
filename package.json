{
  "name": "goxlr-streamlabs-sync",
  "version": "0.5.0",
  "description": "Sync GoXLR faders & mute buttons to Streamlabs Desktop audio sources in real time (via GoXLR Utility). Perfect companion for multi-track recording.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "goxlr-streamlabs-sync": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "list": "node src/index.js --list",
    "make:icon": "node scripts/make-icon.mjs",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Corail44/goxlr-streamlabs-sync.git"
  },
  "homepage": "https://github.com/Corail44/goxlr-streamlabs-sync#readme",
  "bugs": {
    "url": "https://github.com/Corail44/goxlr-streamlabs-sync/issues"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "postject": "^1.0.0-alpha.6"
  },
  "keywords": [
    "goxlr",
    "goxlr-utility",
    "streamlabs",
    "streamlabs-desktop",
    "fader",
    "sync",
    "audio",
    "streaming",
    "multitrack"
  ],
  "license": "MIT"
}
